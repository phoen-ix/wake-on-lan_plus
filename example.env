# Tag of ghcr.io/phoen-ix/wake-on-lan_plus: latest (master), sha-<short> or X.Y.Z
WAKE_ON_LAN_PLUS_IMAGE=latest

# Container Configuration
CONTAINER_NAME=wake-on-lan_plus

# Port Configuration. Only used on a bridge network: on the macvlan network
# docker-compose.yml sets up, open http://<ipv4_address>/ (port 80) instead.
HOST_PORT=3880
CONTAINER_PORT=80

# Authentication (optional - leave empty to disable)
# Set both to enable HTTP Basic Authentication
WOL_USERNAME=
WOL_PASSWORD=

# Rate limits per browser session (optional - leave empty for the defaults:
# 10 config saves, 120 host checks and 5 wake-ups per 60-second window).
# No comment after an empty value: compose would take the comment as the value.
WOL_RATE_LIMIT_CONFIG_SET=
WOL_RATE_LIMIT_HOST_CHECK=
WOL_RATE_LIMIT_HOST_WAKEUP=
WOL_RATE_LIMIT_WINDOW_SECS=
