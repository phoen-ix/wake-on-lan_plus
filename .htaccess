# Protect config.json, its temp files and backups from direct web access
<FilesMatch "^config\.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# The old monolith (gone from the repo): still blocked for bare-metal installs
# that kept a copy from before the rewrite
<FilesMatch "wake-on-lan_plus\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
